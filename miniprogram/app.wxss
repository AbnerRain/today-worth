page {
  min-height: 100%;
  background: #f5f7fb;
  color: #131b2b;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

button::after {
  border: 0;
}

.page-shell {
  min-height: 100vh;
  padding: 28rpx 28rpx calc(44rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background-image: radial-gradient(circle at 1px 1px, rgba(19, 27, 43, 0.08) 1px, transparent 1.5px);
  background-size: 22rpx 22rpx;
}

.comic-card {
  border: 4rpx solid #131b2b;
  border-radius: 16rpx;
  background: #ffffff;
  box-shadow: 8rpx 8rpx 0 #131b2b;
}

.section-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20rpx;
  margin: 40rpx 0 20rpx;
}

.section-heading text:first-child {
  font-size: 34rpx;
  font-weight: 900;
}

.section-heading text:last-child {
  color: #687186;
  font-size: 22rpx;
  font-weight: 700;
}
