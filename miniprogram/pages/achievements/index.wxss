.page-header { display: flex; flex-direction: column; gap: 8rpx; margin: 6rpx 0 26rpx; }
.page-title { font-size: 52rpx; font-weight: 900; }
.page-subtitle { color: #596377; font-size: 24rpx; font-weight: 700; }
.pass { padding: 26rpx; background: #ffdc3f; }
.pass-head { display: flex; justify-content: space-between; font-size: 27rpx; font-weight: 900; }
.pass-track { height: 24rpx; margin: 20rpx 0 12rpx; overflow: hidden; border: 3rpx solid #131b2b; border-radius: 999rpx; background: #fff; }
.pass-fill { height: 100%; background: #2f6bff; }
.pass-foot { color: #596377; font-size: 21rpx; font-weight: 700; }
.activity-progress-list { display: grid; gap: 14rpx; margin-top: 24rpx; padding-top: 20rpx; border-top: 3rpx dashed rgba(19,27,43,.35); }
.activity-progress-row { min-width: 0; }
.activity-progress-head { display: flex; align-items: center; justify-content: space-between; color: #303b50; font-size: 21rpx; font-weight: 900; }
.activity-progress-name { display: flex; align-items: center; gap: 9rpx; }
.activity-progress-stamp { display: inline-flex; width: 38rpx; height: 30rpx; align-items: center; justify-content: center; border: 2rpx solid #131b2b; border-radius: 6rpx; background: #fff; font-size: 16rpx; line-height: 1; }
.activity-progress-stamp.activity-toilet { background: #bff5df; }
.activity-progress-stamp.activity-meal { background: #fff0a6; }
.activity-progress-stamp.activity-nap { background: #cbe8ff; }
.activity-progress-track { height: 12rpx; margin-top: 8rpx; overflow: hidden; border: 2rpx solid #131b2b; border-radius: 999rpx; background: rgba(255,255,255,.72); }
.activity-progress-fill { height: 100%; min-width: 0; }
.activity-progress-detail { display: block; margin-top: 5rpx; color: #687186; font-size: 17rpx; font-weight: 700; }
.filter-tabs { display: flex; width: 100%; margin: 32rpx 0 20rpx; padding: 6rpx; overflow: hidden; border: 3rpx solid #131b2b; border-radius: 14rpx; background: #e7ebf1; box-sizing: border-box; }
.filter-button { display: flex; flex: 1 1 0; width: 0; min-width: 0; height: 64rpx; margin: 0; padding: 0; align-items: center; justify-content: center; overflow: hidden; border-radius: 10rpx; background: transparent; color: #687186; font-size: 22rpx; font-weight: 900; line-height: 58rpx; text-overflow: ellipsis; white-space: nowrap; box-sizing: border-box; }
.filter-button.is-active { background: #2f6bff; box-shadow: 4rpx 4rpx 0 #131b2b; color: #fff; }
.badge-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20rpx; }
.badge-card { display: flex; min-height: 318rpx; padding: 20rpx; flex-direction: column; box-sizing: border-box; }
.badge-card.is-locked { color: #697286; box-shadow: 5rpx 5rpx 0 #939cab; }
.badge-meta { display: flex; justify-content: space-between; color: #687186; font-size: 18rpx; font-weight: 800; }
.badge-avatar { position: relative; display: flex; width: 112rpx; height: 112rpx; margin: 16rpx auto 12rpx; align-items: center; justify-content: center; border: 3rpx solid #131b2b; border-radius: 50%; background: #f5f7fb; box-sizing: border-box; }
.badge-avatar.activity-toilet { background: #bff5df; }
.badge-avatar.activity-meal { background: #fff0a6; }
.badge-avatar.activity-nap { background: #cbe8ff; }
.badge-avatar.is-locked { filter: grayscale(1); opacity: .46; }
.badge-ear { position: absolute; top: 11rpx; width: 31rpx; height: 34rpx; border: 3rpx solid #131b2b; border-radius: 50% 50% 10rpx 10rpx; background: inherit; }
.badge-ear-left { left: 11rpx; transform: rotate(-28deg); }
.badge-ear-right { right: 11rpx; transform: rotate(28deg); }
.badge-face { position: relative; z-index: 2; display: flex; width: 78rpx; height: 78rpx; align-items: center; justify-content: center; border: 3rpx solid #131b2b; border-radius: 50%; background: #fff; box-shadow: 4rpx 4rpx 0 rgba(19,27,43,.25); }
.badge-eyes { position: absolute; left: 20rpx; right: 20rpx; top: 22rpx; display: flex; justify-content: space-between; }
.badge-eyes view { width: 7rpx; height: 7rpx; border-radius: 50%; background: #131b2b; }
.badge-glyph { margin-top: 18rpx; font-size: 30rpx; font-weight: 900; line-height: 1; }
.badge-mini-stamp { position: absolute; right: -4rpx; bottom: -5rpx; z-index: 3; display: flex; min-width: 34rpx; height: 30rpx; padding: 0 5rpx; align-items: center; justify-content: center; border: 3rpx solid #131b2b; border-radius: 7rpx; background: #ffdc3f; font-size: 15rpx; font-weight: 900; line-height: 1; box-sizing: border-box; }
.badge-title { font-size: 28rpx; font-weight: 900; text-align: center; }
.badge-desc { min-height: 66rpx; margin: 8rpx 0 16rpx; color: #687186; font-size: 20rpx; line-height: 1.5; text-align: center; }
.badge-track { height: 14rpx; margin-top: auto; overflow: hidden; border: 2rpx solid #131b2b; border-radius: 999rpx; background: #edf0f4; }
.badge-fill { height: 100%; }
.badge-progress { margin-top: 8rpx; color: #687186; font-size: 18rpx; text-align: center; }
