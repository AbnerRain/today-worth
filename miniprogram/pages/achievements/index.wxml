<view class="page-shell achievements-page">
  <view class="page-header"><text class="page-title">摸鱼履历</text><text class="page-subtitle">上班没有白上，章也不能白盖。</text></view>
  <view class="pass comic-card">
    <view class="pass-head"><text>履历完成度</text><text>{{unlockedCount}} / {{totalCount}}</text></view>
    <view class="pass-track"><view class="pass-fill" style="width: {{completion}}%;"></view></view>
    <text class="pass-foot">已解锁 {{completion}}%</text>
  </view>
  <view class="filter-tabs">
    <button wx:for="{{filters}}" wx:key="key" class="filter-button {{activeFilter === item.key ? 'is-active' : ''}}" data-filter="{{item.key}}" bindtap="selectFilter">{{item.label}}</button>
  </view>
  <view class="badge-grid">
    <view wx:for="{{badges}}" wx:key="id" class="badge-card comic-card {{item.unlocked ? 'is-unlocked' : 'is-locked'}}">
      <view class="badge-meta"><text>{{item.activityLabel}}线</text><text>NO.{{item.index}}</text></view>
      <image class="badge-stamp {{item.unlocked ? 'is-unlocked' : 'is-locked'}}" src="{{item.image}}" mode="aspectFit" />
      <text class="badge-title">{{item.title}}</text>
      <text class="badge-desc">{{item.desc}}</text>
      <view class="badge-track"><view class="badge-fill" style="width: {{item.progress}}%; background: {{item.color}};"></view></view>
      <text class="badge-progress">{{item.progressText}}</text>
    </view>
  </view>
</view>
