.activity-stamp { display: flex; min-width: 48rpx; height: 42rpx; padding: 0 8rpx; align-items: center; justify-content: center; border: 3rpx solid #131b2b; border-radius: 7rpx; background: #f5f7fb; font-size: 20rpx; font-weight: 900; }
