.reward-item:nth-child(7) { left: 8%; animation-delay: 1.08s; animation-duration: 3.36s; --reward-drift: 82rpx; --reward-spin: 410deg; --reward-scale: .94; }
.reward-item:nth-child(8) { left: 26%; animation-delay: 1.26s; animation-duration: 3.76s; --reward-drift: -44rpx; --reward-spin: -560deg; --reward-scale: .9; }
.reward-item:nth-child(9) { left: 40%; animation-delay: 1.44s; animation-duration: 3.54s; --reward-drift: 56rpx; --reward-spin: 450deg; --reward-scale: 1.08; }
.reward-item:nth-child(10) { left: 55%; animation-delay: 1.62s; animation-duration: 3.22s; --reward-drift: -62rpx; --reward-spin: -390deg; --reward-scale: .88; }
.reward-item:nth-child(11) { left: 78%; animation-delay: 1.8s; animation-duration: 3.84s; --reward-drift: -58rpx; --reward-spin: 540deg; --reward-scale: 1; }
.reward-item:nth-child(12) { left: 64%; animation-delay: 1.98s; animation-duration: 3.48s; --reward-drift: 48rpx; --reward-spin: -430deg; --reward-scale: .92; }
.reward-item:nth-child(13) { left: 1%; animation-delay: 2.16s; animation-duration: 3.96s; --reward-drift: 64rpx; --reward-spin: 500deg; --reward-scale: 1.04; }
.reward-item:nth-child(14) { left: 35%; animation-delay: 2.34s; animation-duration: 3.3s; --reward-drift: -52rpx; --reward-spin: -470deg; --reward-scale: .86; }
.reward-item:nth-child(15) { left: 69%; animation-delay: 2.52s; animation-duration: 3.7s; --reward-drift: -76rpx; --reward-spin: 390deg; --reward-scale: .98; }
.reward-item:nth-child(16) { left: 15%; animation-delay: 2.7s; animation-duration: 3.42s; --reward-drift: 74rpx; --reward-spin: -520deg; --reward-scale: .9; }
.reward-item:nth-child(17) { left: 52%; animation-delay: 2.88s; animation-duration: 3.14s; --reward-drift: -36rpx; --reward-spin: 460deg; --reward-scale: 1.08; }
.reward-item:nth-child(18) { left: 70%; animation-delay: 3.06s; animation-duration: 3.86s; --reward-drift: 54rpx; --reward-spin: -400deg; --reward-scale: .88; }
.onboarding-mask { position: fixed; inset: 0; z-index: 120; background: #f5f7fb; }
.onboarding-scroll { width: 100%; height: 100%; }
.onboarding-sheet { min-height: 100vh; padding: calc(52rpx + env(safe-area-inset-top)) 38rpx calc(42rpx + env(safe-area-inset-bottom)); background-image: radial-gradient(circle at 1px 1px,rgba(19,27,43,.08) 1px,transparent 1.5px); background-size: 22rpx 22rpx; box-sizing: border-box; }
.onboarding-mark { display: flex; width: 106rpx; height: 106rpx; margin-bottom: 34rpx; flex-direction: column; align-items: center; justify-content: center; border: 5rpx solid #131b2b; border-radius: 18rpx; background: #ffdc3f; box-shadow: 8rpx 8rpx 0 #131b2b; color: #131b2b; font-size: 46rpx; font-weight: 900; line-height: 1; transform: rotate(-3deg); }
.onboarding-mark-time { margin-top: 5rpx; font-size: 15rpx; }
.onboarding-kicker, .onboarding-title, .onboarding-subtitle, .onboarding-privacy { display: block; }
.onboarding-kicker { color: #2f6bff; font-size: 21rpx; font-weight: 900; }
.onboarding-title { margin-top: 10rpx; font-size: 50rpx; font-weight: 900; line-height: 1.18; }
.onboarding-subtitle { margin-top: 14rpx; color: #596377; font-size: 24rpx; font-weight: 700; line-height: 1.55; }
.onboarding-form { margin-top: 34rpx; border-top: 4rpx solid #131b2b; }
.onboarding-field { display: flex; min-width: 0; padding: 22rpx 0; flex-direction: column; gap: 12rpx; border-bottom: 2rpx dashed #aeb7c5; }
.onboarding-field-row { display: flex; gap: 22rpx; }
.onboarding-half { flex: 1 1 0; width: 0; }
.onboarding-label { color: #303b50; font-size: 22rpx; font-weight: 900; }
.onboarding-control { display: grid; min-width: 0; grid-template-columns: 1fr auto; align-items: center; gap: 8rpx; }
.onboarding-input { width: 100%; height: 72rpx; padding: 0 16rpx; border: 3rpx solid #131b2b; border-radius: 10rpx; background: #fff; color: #131b2b; font-size: 27rpx; font-weight: 800; box-sizing: border-box; }
.onboarding-unit { min-width: 30rpx; font-size: 20rpx; font-weight: 800; }
.onboarding-result { display: grid; margin-top: 28rpx; grid-template-columns: repeat(3,1fr); overflow: hidden; border: 4rpx solid #131b2b; border-radius: 14rpx; background: #ffdc3f; box-shadow: 7rpx 7rpx 0 #131b2b; }
.onboarding-rate { display: flex; min-width: 0; padding: 18rpx 8rpx; flex-direction: column; align-items: center; gap: 6rpx; border-left: 2rpx solid #131b2b; }
.onboarding-rate:first-child { border-left: 0; }
.onboarding-rate-label { color: #596377; font-size: 18rpx; font-weight: 700; }
.onboarding-rate-value { max-width: 100%; overflow: hidden; font-size: 24rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }
.onboarding-submit { width: 100%; height: 94rpx; margin: 32rpx 0 0; border: 4rpx solid #131b2b; border-radius: 14rpx; background: #2f6bff; box-shadow: 8rpx 8rpx 0 #131b2b; color: #fff; font-size: 28rpx; font-weight: 900; box-sizing: border-box; }
.onboarding-privacy { margin-top: 24rpx; color: #687186; font-size: 20rpx; line-height: 1.5; text-align: center; }

.report-mask { position: fixed; inset: 0; z-index: 100; display: flex; padding: 28rpx 30rpx; align-items: center; justify-content: center; overflow-y: auto; background: rgba(19,27,43,.72); }
.report-card { width: 100%; max-height: 94vh; padding: 26rpx; overflow-y: auto; box-sizing: border-box; text-align: center; }
.report-scene { position: relative; height: 238rpx; overflow: hidden; border: 4rpx solid #131b2b; border-radius: 12rpx; background: #ffdc3f; }
.report-scene::before, .report-scene::after { content: ""; position: absolute; left: 50%; top: 50%; width: 330rpx; height: 12rpx; background: #131b2b; transform: translate(-50%,-50%) rotate(25deg); opacity: .1; }
.report-scene::after { transform: translate(-50%,-50%) rotate(-25deg); }
.report-scene.report-toilet { background: #edfff7; }
.report-scene.report-meal { background: #fffadc; }
.report-scene.report-nap { background: #eef7ff; }
