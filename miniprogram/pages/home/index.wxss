.scene-meal { background: #fffadc; }
.scene-nap { background: #eef7ff; }
.scene-custom { background: #f4f7ff; }
.mascot-stage { position: relative; width: 200rpx; height: 200rpx; align-self: end; }
.activity-figure { position: absolute; inset: 0; display: block; width: 200rpx; height: 200rpx; overflow: hidden; }
.activity-mascot-image { position: absolute; inset: 0; z-index: 1; display: block; width: 200rpx; height: 200rpx; }
.custom-activity-visual { position: absolute; inset: 0; z-index: 1; display: none; }
.scene-custom .activity-mascot-image { display: none; }
.scene-custom .custom-activity-visual { display: block; }
.custom-visual-ticket { position: absolute; left: 35rpx; top: 39rpx; display: flex; width: 126rpx; height: 112rpx; flex-direction: column; align-items: center; justify-content: center; border: 5rpx solid #131b2b; border-radius: 18rpx; background: #e8f0ff; box-shadow: 8rpx 8rpx 0 #131b2b; transform: rotate(-5deg); animation: custom-ticket-float 1.45s ease-in-out infinite; }
