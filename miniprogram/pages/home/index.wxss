.meter-state { display: block; margin-top: 26rpx; font-size: 26rpx; font-weight: 800; }
.timer { display: block; margin: 6rpx 0 20rpx; font-family: "SF Mono", Menlo, monospace; font-size: 76rpx; font-weight: 900; line-height: 1.05; }
.earning-ticket { position: absolute; right: 24rpx; top: 94rpx; z-index: 2; display: flex; width: 184rpx; flex-direction: column; gap: 4rpx; padding: 14rpx 16rpx; border: 3rpx solid #131b2b; border-radius: 10rpx; background: #fff; box-shadow: 5rpx 5rpx 0 #131b2b; transform: rotate(2deg); }
.earning-label { color: #687186; font-size: 19rpx; font-weight: 700; }
.earning-value { font-size: 31rpx; font-weight: 900; }
.live-line { display: block; max-width: 68%; color: #39445a; font-size: 23rpx; font-weight: 700; line-height: 1.55; }
.activity-scene { position: relative; z-index: 2; display: grid; min-height: 218rpx; margin-top: 24rpx; padding: 14rpx 18rpx 14rpx 12rpx; grid-template-columns: 210rpx minmax(0,1fr); align-items: center; gap: 10rpx; overflow: hidden; border: 4rpx solid #131b2b; border-radius: 12rpx; box-shadow: 6rpx 6rpx 0 #131b2b; box-sizing: border-box; }
.scene-toilet { background: #edfff7; }
.scene-meal { background: #fffadc; }
.scene-nap { background: #eef7ff; }
.mascot-stage { position: relative; width: 200rpx; height: 200rpx; align-self: end; }
.activity-figure { position: absolute; inset: 0; display: block; width: 200rpx; height: 200rpx; overflow: hidden; }
.activity-mascot-image { position: absolute; inset: 0; z-index: 1; display: block; width: 200rpx; height: 200rpx; }
.activity-motion { position: absolute; inset: 0; z-index: 2; display: none; pointer-events: none; }
.scene-toilet .motion-toilet, .scene-meal .motion-meal, .scene-nap .motion-nap { display: block; }
.toilet-strain { position: absolute; left: 78%; width: 12%; height: 5rpx; border-radius: 99rpx; background: #ff6259; transform-origin: left center; animation: toilet-strain-pulse .72s steps(2,end) infinite; }
.toilet-strain-one { top: 28%; transform: rotate(-22deg); }
.toilet-strain-two { top: 36%; animation-delay: .18s; transform: rotate(14deg); }
