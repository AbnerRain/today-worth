.brand-stamp { display: flex; width: 48rpx; height: 48rpx; align-items: center; justify-content: center; border: 4rpx solid #131b2b; border-radius: 8rpx; background: #ffdc3f; font-size: 26rpx; font-weight: 900; transform: rotate(5deg); }
