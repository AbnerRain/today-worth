.onboarding-mark-time { margin-top: 5rpx; font-size: 15rpx; }
.onboarding-kicker, .onboarding-title, .onboarding-subtitle, .onboarding-privacy { display: block; }
.onboarding-kicker { color: #2f6bff; font-size: 21rpx; font-weight: 900; }
.onboarding-title { margin-top: 10rpx; font-size: 50rpx; font-weight: 900; line-height: 1.18; }
.onboarding-subtitle { margin-top: 14rpx; color: #596377; font-size: 24rpx; font-weight: 700; line-height: 1.55; }
.onboarding-form { margin-top: 34rpx; border-top: 4rpx solid #131b2b; }
.onboarding-field { display: flex; min-width: 0; padding: 22rpx 0; flex-direction: column; gap: 12rpx; border-bottom: 2rpx dashed #aeb7c5; }
.onboarding-field-row { display: flex; gap: 22rpx; }
.onboarding-half { flex: 1 1 0; width: 0; }
.onboarding-label { color: #303b50; font-size: 22rpx; font-weight: 900; }
.onboarding-control { display: grid; min-width: 0; grid-template-columns: 1fr auto; align-items: center; gap: 8rpx; }
.onboarding-input { width: 100%; height: 72rpx; padding: 0 16rpx; border: 3rpx solid #131b2b; border-radius: 10rpx; background: #fff; color: #131b2b; font-size: 27rpx; font-weight: 800; box-sizing: border-box; }
.onboarding-unit { min-width: 30rpx; font-size: 20rpx; font-weight: 800; }
.onboarding-result { display: grid; margin-top: 28rpx; grid-template-columns: repeat(3,1fr); overflow: hidden; border: 4rpx solid #131b2b; border-radius: 14rpx; background: #ffdc3f; box-shadow: 7rpx 7rpx 0 #131b2b; }
.onboarding-rate { display: flex; min-width: 0; padding: 18rpx 8rpx; flex-direction: column; align-items: center; gap: 6rpx; border-left: 2rpx solid #131b2b; }
.onboarding-rate:first-child { border-left: 0; }
.onboarding-rate-label { color: #596377; font-size: 18rpx; font-weight: 700; }
.onboarding-rate-value { max-width: 100%; overflow: hidden; font-size: 24rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }
.onboarding-submit { display: flex; width: 100%; height: 94rpx; margin: 32rpx 0 0; padding: 0 22rpx; align-items: center; justify-content: center; overflow: hidden; border: 4rpx solid #131b2b; border-radius: 14rpx; background: #2f6bff; box-shadow: 8rpx 8rpx 0 #131b2b; color: #fff; font-size: 28rpx; font-weight: 900; line-height: 1; white-space: nowrap; box-sizing: border-box; }
.onboarding-submit::after { border: 0; }
.onboarding-submit-label { max-width: 100%; overflow: hidden; line-height: 1; text-overflow: ellipsis; white-space: nowrap; }
.onboarding-privacy { margin-top: 24rpx; color: #687186; font-size: 20rpx; line-height: 1.5; text-align: center; }

.editor-mask { position: fixed; inset: 0; z-index: 110; display: flex; padding: 30rpx; align-items: center; justify-content: center; overflow-y: auto; background: rgba(19,27,43,.72); box-sizing: border-box; }
.editor-card { width: 100%; max-height: 92vh; padding: 28rpx; overflow-y: auto; box-sizing: border-box; }
.editor-kicker, .editor-title, .editor-note { display: block; }
.editor-kicker { color: #2f6bff; font-size: 20rpx; font-weight: 900; }
.editor-title { margin-top: 8rpx; font-size: 34rpx; font-weight: 900; line-height: 1.2; }
.editor-note { margin-top: 10rpx; color: #596377; font-size: 22rpx; font-weight: 700; line-height: 1.45; }
.editor-field { display: flex; min-width: 0; margin-top: 22rpx; flex-direction: column; gap: 10rpx; }
.editor-label { color: #303b50; font-size: 22rpx; font-weight: 900; }
.editor-label-row { display: flex; min-width: 0; align-items: center; justify-content: space-between; gap: 16rpx; }
.editor-count { flex: 0 0 auto; color: #687186; font-size: 19rpx; font-weight: 800; }
.editor-control { display: grid; min-width: 0; grid-template-columns: 1fr auto; align-items: center; gap: 10rpx; }
.editor-input, .editor-textarea { width: 100%; min-width: 0; border: 3rpx solid #131b2b; border-radius: 10rpx; background: #fff; color: #131b2b; font-size: 27rpx; font-weight: 800; box-sizing: border-box; }
.editor-input { height: 74rpx; padding: 0 16rpx; }
.editor-textarea { height: 150rpx; padding: 16rpx; line-height: 1.45; }
.editor-unit { min-width: 32rpx; font-size: 22rpx; font-weight: 900; }
.mode-grid { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 12rpx; }
.mode-chip { display: flex; width: 100%; min-width: 0; height: 64rpx; margin: 0; padding: 0 10rpx; align-items: center; justify-content: center; border: 3rpx solid #131b2b; border-radius: 10rpx; background: #fff; color: #131b2b; font-size: 21rpx; font-weight: 900; box-sizing: border-box; }
.mode-chip.is-active { background: #ffdc3f; }
.editor-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin-top: 28rpx; }
.editor-button { width: 100%; height: 82rpx; margin: 0; overflow: hidden; border: 3rpx solid #131b2b; border-radius: 12rpx; font-size: 26rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; box-sizing: border-box; }
.editor-primary { background: #2f6bff; box-shadow: 5rpx 5rpx 0 #131b2b; color: #fff; }
.editor-secondary { background: #fff; color: #131b2b; }

.report-mask { position: fixed; inset: 0; z-index: 100; display: flex; padding: 28rpx 30rpx; align-items: center; justify-content: center; overflow-y: auto; background: rgba(19,27,43,.72); }
.report-card { width: 100%; max-height: 94vh; padding: 26rpx; overflow-y: auto; box-sizing: border-box; text-align: center; }
.report-scene { position: relative; height: 258rpx; overflow: hidden; border: 4rpx solid #131b2b; border-radius: 12rpx; background-color: #edfff7; background-image: radial-gradient(circle at 1rpx 1rpx,rgba(19,27,43,.09) 1rpx,transparent 1.5rpx); background-size: 20rpx 20rpx; }
.report-scene::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; z-index: 0; height: 54rpx; border-top: 3rpx solid #131b2b; background: #bff5df; }
.report-scene.report-meal { background-color: #fffadc; }
.report-scene.report-meal::after { background: #fff0a6; }
.report-scene.report-nap { background-color: #eef7ff; }
.report-scene.report-nap::after { background: #cbe8ff; }
.report-scene.report-custom { background-color: #f4f7ff; }
.report-scene.report-custom::after { background: #d9ccff; }
.report-scene-mascot { position: absolute; left: 10rpx; bottom: 4rpx; z-index: 2; width: 238rpx; height: 238rpx; }
.report-custom-visual { position: absolute; left: 10rpx; bottom: 4rpx; z-index: 2; width: 238rpx; height: 238rpx; }
.report-custom-ticket { position: absolute; left: 34rpx; bottom: 40rpx; display: flex; width: 128rpx; height: 118rpx; flex-direction: column; align-items: center; justify-content: center; border: 5rpx solid #131b2b; border-radius: 18rpx; background: #e8f0ff; box-shadow: 8rpx 8rpx 0 #131b2b; transform: rotate(-6deg); }
.report-custom-ticket text:first-child { font-size: 56rpx; font-weight: 900; line-height: 1; }
.report-custom-ticket text:last-child { margin-top: 7rpx; color: #5941c9; font-size: 18rpx; font-weight: 900; line-height: 1; }
.report-custom-coin { position: absolute; right: 32rpx; top: 38rpx; display: flex; width: 54rpx; height: 54rpx; align-items: center; justify-content: center; border: 4rpx solid #131b2b; border-radius: 50%; background: #ffdc3f; box-shadow: 5rpx 5rpx 0 #131b2b; font-size: 26rpx; font-weight: 900; animation: report-custom-coin 1.6s ease-in-out infinite; }
.report-scene-ticket { position: absolute; right: 20rpx; top: 78rpx; z-index: 3; display: flex; width: 194rpx; min-height: 104rpx; padding: 13rpx 14rpx; flex-direction: column; align-items: flex-start; justify-content: center; border: 4rpx solid #131b2b; border-radius: 10rpx; background: #fff; box-shadow: 6rpx 6rpx 0 #131b2b; box-sizing: border-box; transform: rotate(1deg); }
.report-ticket-label { color: #687186; font-size: 18rpx; font-weight: 800; }
.report-ticket-money { margin: 5rpx 0; color: #2f6bff; font-family: "SF Mono", Menlo, monospace; font-size: 31rpx; font-weight: 900; line-height: 1; white-space: nowrap; }
.report-meal .report-ticket-money { color: #da3a32; }
.report-nap .report-ticket-money { color: #166999; }
.report-custom .report-ticket-money { color: #5941c9; }
.report-ticket-time { color: #4f596d; font-size: 18rpx; font-weight: 700; }
.report-scene-tag { position: absolute; left: 20rpx; top: 18rpx; z-index: 5; padding: 8rpx 12rpx; border: 3rpx solid #131b2b; border-radius: 7rpx; background: #ffdc3f; color: #131b2b; font-size: 20rpx; font-weight: 900; transform: rotate(-4deg); }
.report-meal .report-scene-tag { background: #fff; transform: rotate(3deg); }
.report-nap .report-scene-tag { background: #bff5df; }
.report-custom .report-scene-tag { background: #e8f0ff; }
.report-stamp { position: absolute; right: 20rpx; top: 18rpx; z-index: 6; display: flex; width: 82rpx; height: 82rpx; align-items: center; justify-content: center; border: 5rpx solid #131b2b; border-radius: 50%; background: #fff; font-size: 30rpx; font-weight: 900; transform: rotate(-7deg); }
.report-pop { position: absolute; right: 28rpx; bottom: 22rpx; z-index: 6; padding: 8rpx 12rpx; border: 3rpx solid #131b2b; background: #ff6259; color: #fff; font-size: 22rpx; font-weight: 900; transform: rotate(7deg); }
.report-title, .report-money, .report-quote { display: block; }
.report-kicker { display: block; margin-top: 20rpx; color: #687186; font-size: 19rpx; font-weight: 900; }
.report-title { margin-top: 6rpx; font-size: 30rpx; font-weight: 900; }
.report-money { margin: 8rpx 0; color: #2f6bff; font-size: 68rpx; font-weight: 900; }
.report-quote { color: #596377; font-size: 23rpx; line-height: 1.5; }
.report-breakdown { display: grid; grid-template-columns: 1fr 1fr; gap: 10rpx; margin: 20rpx 0 12rpx; }
.report-breakdown view { display: flex; min-width: 0; padding: 13rpx 12rpx; flex-direction: column; align-items: flex-start; gap: 4rpx; border: 3rpx solid #131b2b; border-radius: 9rpx; background: #f5f7fb; text-align: left; }
.report-breakdown view:nth-child(1) { background: #fff0a6; }
.report-breakdown view:nth-child(2) { background: #d8efff; }
.report-breakdown view:nth-child(3) { background: #bff5df; }
.report-breakdown view:nth-child(4) { background: #ffd0cc; }
.report-breakdown text:first-child { color: #687186; font-size: 18rpx; font-weight: 700; }
.report-breakdown text:last-child { max-width: 100%; overflow: hidden; font-family: "SF Mono", Menlo, monospace; font-size: 23rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }
.report-caption { display: block; padding: 10rpx 12rpx; border-left: 5rpx solid #2f6bff; background: #e8f0ff; color: #596377; font-size: 20rpx; font-weight: 700; line-height: 1.45; text-align: left; }
.report-meal + .report-kicker { color: #da3a32; }
.share-button, .close-button, .undo-button { display: flex; width: 100%; height: 82rpx; margin: 14rpx 0 0; padding: 0 16rpx; align-items: center; justify-content: center; overflow: hidden; border: 3rpx solid #131b2b; border-radius: 12rpx; font-size: 26rpx; font-weight: 900; line-height: 1; text-align: center; text-overflow: ellipsis; white-space: nowrap; box-sizing: border-box; }
.share-button { background: #2f6bff; box-shadow: 6rpx 6rpx 0 #131b2b; color: #fff; }
.close-button { background: #fff; color: #131b2b; }
.undo-button { background: #fff1ef; color: #a23c38; }
.share-button::after, .close-button::after, .undo-button::after { border: 0; }

@keyframes reward-fall { 0% { opacity: 0; transform: translate3d(0,-80rpx,0) rotate(0deg) scale(var(--reward-scale)); } 7% { opacity: 1; } 92% { opacity: 1; } 100% { opacity: .35; transform: translate3d(var(--reward-drift),calc(100vh + 260rpx),0) rotate(var(--reward-spin)) scale(var(--reward-scale)); } }
@keyframes toilet-strain-pulse { 0%,100% { width: 7%; opacity: .2; } 50% { width: 12%; opacity: 1; } }
@keyframes toilet-puff-pulse { 0%,100% { opacity: .18; transform: scale(.72); } 45% { opacity: 1; transform: scale(1); } }
@keyframes meal-steam-breathe { 0%,100% { opacity: .18; transform: scaleY(.55); } 50% { opacity: .9; transform: scaleY(1); } }
@keyframes meal-spark-pop { 0%,100% { opacity: .25; transform: scale(.7); } 50% { opacity: 1; transform: scale(1); } }
@keyframes meal-slurp-pulse { 0%,100% { opacity: .25; transform: scaleY(.72); } 50% { opacity: .9; transform: scaleY(1); } }
@keyframes nap-z-cycle { 0%,32% { opacity: 0; transform: scale(.75); } 33%,66% { opacity: 1; transform: scale(1); } 67%,100% { opacity: .28; transform: scale(.86); } }
@keyframes nap-breath-pulse { 0%,100% { width: 18rpx; opacity: .22; } 50% { width: 34rpx; opacity: .8; } }
@keyframes nap-ring-pulse { 0%,100% { height: 10rpx; opacity: .15; } 50% { height: 19rpx; opacity: 1; } }
@keyframes custom-ticket-float { 0%,100% { transform: translateY(0) rotate(-5deg); } 50% { transform: translateY(-9rpx) rotate(3deg); } }
@keyframes custom-shadow-breathe { 0%,100% { opacity: .16; transform: scaleX(.82); } 50% { opacity: .28; transform: scaleX(1.08); } }
@keyframes custom-float-rise { 0%,18% { opacity: 0; transform: translateY(12rpx) scale(.7); } 44% { opacity: 1; } 100% { opacity: 0; transform: translateY(-36rpx) scale(1.05); } }
@keyframes custom-ring-pulse { 0% { opacity: .42; transform: scale(.76); } 70%,100% { opacity: 0; transform: scale(1.12); } }
@keyframes report-lid { 0%,100% { transform: rotate(-4deg) translateY(0); } 42% { transform: rotate(2deg) translateY(8rpx); } 65% { transform: rotate(-1deg) translateY(3rpx); } }
