.meter-kicker { display: flex; align-items: center; justify-content: space-between; color: #31405a; font-size: 20rpx; font-weight: 900; }
.live-dot { width: 18rpx; height: 18rpx; border: 3rpx solid #131b2b; border-radius: 50%; background: #fff; }
