.activity-ledger { padding-top: 12rpx; }
.ledger-row { display: grid; grid-template-columns: 54rpx 1fr auto; gap: 14rpx; align-items: center; padding: 14rpx 10rpx; border-bottom: 2rpx dashed #c7cdd7; }
