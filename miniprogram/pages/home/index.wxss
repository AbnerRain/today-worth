.toilet-puff view { position: absolute; border: 3rpx solid #131b2b; border-radius: 50%; background: #fff; }
.toilet-puff view:nth-child(1) { left: 0; bottom: 1rpx; width: 15rpx; height: 15rpx; }
.toilet-puff view:nth-child(2) { left: 10rpx; top: 0; width: 18rpx; height: 18rpx; }
.toilet-puff view:nth-child(3) { right: 0; bottom: 3rpx; width: 13rpx; height: 13rpx; }
.meal-steam { position: absolute; bottom: 33%; width: 13rpx; height: 31rpx; border-left: 4rpx solid #11a66a; border-radius: 50%; transform-origin: center bottom; animation: meal-steam-breathe 1s ease-in-out infinite; }
.meal-steam-one { left: 35%; }
.meal-steam-two { left: 44%; animation-delay: .3s; }
.meal-spark { position: absolute; left: 73%; top: 28%; color: #ff9f1c; font-size: 27rpx; font-weight: 900; line-height: 1; transform-origin: center; animation: meal-spark-pop .9s steps(2,end) infinite; }
.meal-slurp { position: absolute; left: 48%; top: 31%; width: 24rpx; height: 34rpx; border: 4rpx solid transparent; border-left-color: #ff9f1c; border-radius: 50%; transform-origin: center bottom; animation: meal-slurp-pulse .68s ease-in-out infinite; }
.nap-z { position: absolute; color: #2f6bff; font-family: "SF Mono", Menlo, monospace; font-style: normal; font-weight: 900; line-height: 1; opacity: 0; animation: nap-z-cycle 2.1s steps(1,end) infinite; }
