@keyframes report-bed { 0%,100% { transform: translateY(0) scaleY(1); } 44% { transform: translateY(4rpx) scaleY(.94); } 68% { transform: translateY(1rpx) scaleY(.98); } }
@keyframes report-zzz { 0%,25% { opacity: 0; transform: translate(2rpx,8rpx) scale(.6); } 53% { opacity: 1; } 100% { opacity: 0; transform: translate(16rpx,-28rpx) scale(1.08); } }
@keyframes report-custom-coin { 0%,100% { transform: translateY(0) rotate(-8deg); } 48% { transform: translateY(-10rpx) rotate(9deg); } }
@keyframes money-tick { 50% { transform: translateY(-2rpx) scale(1.025); } }
@keyframes pulse { 50% { transform: scale(1.35); opacity: .55; } }
