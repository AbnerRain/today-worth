.nap-breath { position: absolute; left: 39%; top: 57%; width: 34rpx; height: 8rpx; border-radius: 99rpx; background: rgba(47,107,255,.28); transform-origin: left center; animation: nap-breath-pulse 1.8s ease-in-out infinite; }
.nap-ring { position: absolute; top: 46%; width: 4rpx; height: 19rpx; border-radius: 99rpx; background: #ff6259; transform-origin: center bottom; animation: nap-ring-pulse 1.2s steps(2,end) infinite; }
.nap-ring-one { left: 82%; transform: rotate(-28deg); }
.nap-ring-two { left: 91%; animation-delay: .2s; transform: rotate(28deg); }
.scene-copy { display: flex; min-width: 0; padding: 10rpx 0; flex-direction: column; align-items: flex-start; }
.scene-badge { padding: 7rpx 12rpx; border: 3rpx solid #131b2b; border-radius: 7rpx; background: #131b2b; color: #fff; font-size: 18rpx; font-weight: 900; }
.scene-money { max-width: 100%; margin: 8rpx 0 4rpx; color: #2f6bff; font-size: 43rpx; font-weight: 900; line-height: 1.12; animation: money-tick 1s steps(2,end) infinite; }
.scene-line { color: #4f596d; font-size: 20rpx; font-weight: 700; line-height: 1.45; }

.activity-grid { display: flex; gap: 16rpx; }
.activity-button { display: flex; flex: 1 1 0; width: 0; min-width: 0; height: 156rpx; margin: 0; padding: 16rpx 10rpx; flex-direction: column; align-items: center; justify-content: center; border: 3rpx solid #131b2b; border-radius: 14rpx; background: #fff; box-shadow: 5rpx 5rpx 0 #131b2b; color: #131b2b; line-height: 1.15; box-sizing: border-box; }
