.report-scene.report-nap::after { display: none; }
.report-visual { position: absolute; inset: 0; z-index: 1; display: none; }
.report-toilet .report-visual-toilet, .report-meal .report-visual-meal, .report-nap .report-visual-nap { display: block; }
.visual-toilet-lid { position: absolute; left: 96rpx; top: 54rpx; width: 106rpx; height: 70rpx; border: 6rpx solid #131b2b; border-radius: 24rpx 24rpx 8rpx 8rpx; background: #fff; transform: rotate(-4deg); animation: report-lid 1.7s steps(4,end) infinite; }
.visual-toilet-bowl { position: absolute; left: 84rpx; bottom: 28rpx; width: 132rpx; height: 72rpx; border: 6rpx solid #131b2b; border-radius: 12rpx 12rpx 52rpx 52rpx; background: #fff; transform: rotate(3deg); }
.visual-water { width: 88rpx; height: 20rpx; margin: 17rpx auto 0; border: 4rpx solid #131b2b; border-radius: 50%; background: #9bd4ff; animation: report-water 1.1s steps(4,end) infinite; }
.visual-roll { position: absolute; right: 66rpx; bottom: 36rpx; width: 38rpx; height: 38rpx; border: 5rpx solid #131b2b; border-radius: 50%; background: #ffdc3f; box-shadow: 0 42rpx 0 -12rpx #fff, 0 42rpx 0 -7rpx #131b2b; animation: report-roll 1.8s steps(4,end) infinite; }
.visual-coin { position: absolute; display: flex; width: 38rpx; height: 38rpx; align-items: center; justify-content: center; border: 4rpx solid #131b2b; border-radius: 50%; background: #ffdc3f; color: #131b2b; font-size: 21rpx; font-weight: 900; }
.coin-one { left: 42rpx; top: 34rpx; animation: report-coin-pop 1.8s steps(5,end) infinite; }
.coin-two { right: 24rpx; top: 58rpx; animation: report-coin-pop 1.8s steps(5,end) .42s infinite; }
.visual-bowl { position: absolute; left: 68rpx; bottom: 32rpx; width: 172rpx; height: 70rpx; border: 6rpx solid #131b2b; border-radius: 12rpx 12rpx 68rpx 68rpx; background: #ff6259; animation: report-bowl 1.35s steps(5,end) infinite; }
.visual-rice { width: 122rpx; height: 28rpx; margin: 11rpx auto 0; border: 4rpx solid #131b2b; border-radius: 50%; background: #fff; }
.visual-steam { position: absolute; top: 34rpx; width: 12rpx; height: 58rpx; border-left: 5rpx solid #ff6259; border-radius: 50%; animation: report-steam 1.35s steps(5,end) infinite; }
.steam-one { left: 124rpx; }
.steam-two { left: 162rpx; animation-delay: .3s; }
.visual-chopsticks { position: absolute; right: 56rpx; top: 26rpx; width: 7rpx; height: 100rpx; border-radius: 99rpx; background: #131b2b; transform: rotate(32deg); box-shadow: 20rpx 10rpx 0 #ff6259; animation: report-chopsticks 1.35s steps(5,end) infinite; }
.visual-spark { position: absolute; left: 36rpx; top: 74rpx; color: #ff6259; font-size: 38rpx; animation: report-spark 1.2s steps(3,end) infinite; }
.visual-moon { position: absolute; right: 38rpx; top: 30rpx; width: 58rpx; height: 58rpx; border: 5rpx solid #131b2b; border-radius: 50%; background: #ffdc3f; box-shadow: -15rpx 8rpx 0 #eef7ff; animation: report-moon 2.6s steps(5,end) infinite; }
.visual-bed { position: absolute; left: 42rpx; right: 38rpx; bottom: 28rpx; height: 64rpx; border: 6rpx solid #131b2b; border-radius: 16rpx 16rpx 10rpx 10rpx; background: #2f6bff; animation: report-bed 2.6s steps(5,end) infinite; }
.visual-pillow { position: absolute; left: 14rpx; top: -28rpx; width: 78rpx; height: 48rpx; border: 5rpx solid #131b2b; border-radius: 24rpx; background: #fff; }
.visual-blanket { position: absolute; left: 72rpx; right: 10rpx; top: -12rpx; height: 50rpx; border: 5rpx solid #131b2b; border-radius: 28rpx 28rpx 8rpx 8rpx; background: #9bd4ff; }
.visual-zzz { position: absolute; color: #2f6bff; font-family: "SF Mono", Menlo, monospace; font-size: 32rpx; font-weight: 900; opacity: 0; }
.zzz-one { left: 160rpx; top: 38rpx; animation: report-zzz 2.6s steps(5,end) infinite; }
.zzz-two { left: 206rpx; top: 18rpx; font-size: 22rpx; animation: report-zzz 2.6s steps(5,end) .8s infinite; }
.report-scene-tag { position: absolute; left: 20rpx; top: 18rpx; z-index: 5; padding: 8rpx 12rpx; border: 3rpx solid #131b2b; border-radius: 7rpx; background: #ffdc3f; color: #131b2b; font-size: 20rpx; font-weight: 900; transform: rotate(-4deg); }
.report-meal .report-scene-tag { background: #fff; transform: rotate(3deg); }
.report-nap .report-scene-tag { background: #bff5df; }
.report-stamp { position: absolute; right: 20rpx; top: 18rpx; z-index: 6; display: flex; width: 82rpx; height: 82rpx; align-items: center; justify-content: center; border: 5rpx solid #131b2b; border-radius: 50%; background: #fff; font-size: 30rpx; font-weight: 900; transform: rotate(-7deg); }
.report-pop { position: absolute; right: 28rpx; bottom: 22rpx; z-index: 6; padding: 8rpx 12rpx; border: 3rpx solid #131b2b; background: #ff6259; color: #fff; font-size: 22rpx; font-weight: 900; transform: rotate(7deg); }
.report-title, .report-money, .report-quote { display: block; }
.report-kicker { display: block; margin-top: 20rpx; color: #687186; font-size: 19rpx; font-weight: 900; }
.report-title { margin-top: 6rpx; font-size: 30rpx; font-weight: 900; }
.report-money { margin: 8rpx 0; color: #2f6bff; font-size: 68rpx; font-weight: 900; }
.report-quote { color: #596377; font-size: 23rpx; line-height: 1.5; }
.report-breakdown { display: grid; grid-template-columns: 1fr 1fr; gap: 10rpx; margin: 20rpx 0 12rpx; }
.report-breakdown view { display: flex; min-width: 0; padding: 13rpx 12rpx; flex-direction: column; align-items: flex-start; gap: 4rpx; border: 3rpx solid #131b2b; border-radius: 9rpx; background: #f5f7fb; text-align: left; }
.report-breakdown view:nth-child(1) { background: #fff0a6; }
.report-breakdown view:nth-child(2) { background: #d8efff; }
.report-breakdown view:nth-child(3) { background: #bff5df; }
.report-breakdown view:nth-child(4) { background: #ffd0cc; }
.report-breakdown text:first-child { color: #687186; font-size: 18rpx; font-weight: 700; }
.report-breakdown text:last-child { max-width: 100%; overflow: hidden; font-family: "SF Mono", Menlo, monospace; font-size: 23rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }
.report-caption { display: block; padding: 10rpx 12rpx; border-left: 5rpx solid #2f6bff; background: #e8f0ff; color: #596377; font-size: 20rpx; font-weight: 700; line-height: 1.45; text-align: left; }
.report-meal + .report-kicker { color: #da3a32; }
.share-button, .close-button { width: 100%; height: 82rpx; margin: 14rpx 0 0; border: 3rpx solid #131b2b; border-radius: 12rpx; font-size: 26rpx; font-weight: 900; }
.share-button { background: #2f6bff; box-shadow: 6rpx 6rpx 0 #131b2b; color: #fff; }
.close-button { background: #fff; color: #131b2b; }

@keyframes reward-fall { 0% { opacity: 0; transform: translate3d(0,-80rpx,0) rotate(0deg) scale(var(--reward-scale)); } 7% { opacity: 1; } 92% { opacity: 1; } 100% { opacity: .35; transform: translate3d(var(--reward-drift),calc(100vh + 260rpx),0) rotate(var(--reward-spin)) scale(var(--reward-scale)); } }
@keyframes toilet-strain-pulse { 0%,100% { width: 7%; opacity: .2; } 50% { width: 12%; opacity: 1; } }
@keyframes toilet-puff-pulse { 0%,100% { opacity: .18; transform: scale(.72); } 45% { opacity: 1; transform: scale(1); } }
@keyframes meal-steam-breathe { 0%,100% { opacity: .18; transform: scaleY(.55); } 50% { opacity: .9; transform: scaleY(1); } }
@keyframes meal-spark-pop { 0%,100% { opacity: .25; transform: scale(.7); } 50% { opacity: 1; transform: scale(1); } }
@keyframes meal-slurp-pulse { 0%,100% { opacity: .25; transform: scaleY(.72); } 50% { opacity: .9; transform: scaleY(1); } }
@keyframes nap-z-cycle { 0%,32% { opacity: 0; transform: scale(.75); } 33%,66% { opacity: 1; transform: scale(1); } 67%,100% { opacity: .28; transform: scale(.86); } }
@keyframes nap-breath-pulse { 0%,100% { width: 18rpx; opacity: .22; } 50% { width: 34rpx; opacity: .8; } }
@keyframes nap-ring-pulse { 0%,100% { height: 10rpx; opacity: .15; } 50% { height: 19rpx; opacity: 1; } }
@keyframes report-lid { 0%,100% { transform: rotate(-4deg) translateY(0); } 42% { transform: rotate(2deg) translateY(8rpx); } 65% { transform: rotate(-1deg) translateY(3rpx); } }
@keyframes report-water { 0%,100% { transform: scaleX(.78); } 45% { transform: scaleX(1.08); } 70% { transform: scaleX(.9); } }
@keyframes report-roll { 0%,100% { transform: rotate(-4deg); } 42% { transform: rotate(7deg) translateY(-3rpx); } 66% { transform: rotate(-2deg); } }
@keyframes report-coin-pop { 0%,18% { opacity: 0; transform: translateY(10rpx) scale(.55) rotate(-20deg); } 42% { opacity: 1; } 100% { opacity: 0; transform: translate(18rpx,-34rpx) scale(1.05) rotate(28deg); } }
@keyframes report-bowl { 0%,100% { transform: translateY(0) rotate(-2deg); } 36% { transform: translateY(5rpx) rotate(2deg); } 60% { transform: translateY(1rpx) rotate(-1deg); } }
@keyframes report-steam { 0%,20% { opacity: 0; transform: translateY(12rpx) scale(.7); } 48% { opacity: .85; } 100% { opacity: 0; transform: translate(8rpx,-28rpx) scale(1.1); } }
@keyframes report-chopsticks { 0%,100% { transform: rotate(32deg); } 40% { transform: rotate(20deg) translate(-3rpx,5rpx); } 62% { transform: rotate(37deg); } }
@keyframes report-spark { 0%,25% { opacity: 0; transform: scale(.65) rotate(-18deg); } 55% { opacity: 1; } 100% { opacity: 0; transform: scale(1.18) rotate(12deg); } }
@keyframes report-moon { 0%,100% { transform: translateY(0) rotate(-5deg); } 48% { transform: translateY(5rpx) rotate(5deg); } }
@keyframes report-bed { 0%,100% { transform: translateY(0) scaleY(1); } 44% { transform: translateY(4rpx) scaleY(.94); } 68% { transform: translateY(1rpx) scaleY(.98); } }
@keyframes report-zzz { 0%,25% { opacity: 0; transform: translate(2rpx,8rpx) scale(.6); } 53% { opacity: 1; } 100% { opacity: 0; transform: translate(16rpx,-28rpx) scale(1.08); } }
@keyframes money-tick { 50% { transform: translateY(-2rpx) scale(1.025); } }
@keyframes pulse { 50% { transform: scale(1.35); opacity: .55; } }
