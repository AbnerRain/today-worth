.nap-z { position: absolute; color: #2f6bff; font-family: "SF Mono", Menlo, monospace; font-style: normal; font-weight: 900; line-height: 1; opacity: 0; animation: nap-z-cycle 2.1s steps(1,end) infinite; }
.nap-z-one { left: 70%; top: 12%; font-size: 18rpx; }
