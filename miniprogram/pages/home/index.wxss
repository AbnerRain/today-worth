@keyframes report-coin-pop { 0%,18% { opacity: 0; transform: translateY(10rpx) scale(.55) rotate(-20deg); } 42% { opacity: 1; } 100% { opacity: 0; transform: translate(18rpx,-34rpx) scale(1.05) rotate(28deg); } }
