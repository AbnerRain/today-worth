.settings-button { display: inline-flex; flex: 0 0 152rpx; width: 152rpx; max-width: 152rpx; min-width: 0; height: 56rpx; margin: 0 0 0 auto; padding: 0 8rpx; align-items: center; justify-content: center; gap: 5rpx; overflow: hidden; border: 3rpx solid #131b2b; border-radius: 10rpx; background: #fff; box-shadow: 4rpx 4rpx 0 #131b2b; color: #131b2b; font-size: 21rpx; font-weight: 900; line-height: 1; white-space: nowrap; box-sizing: border-box; }
