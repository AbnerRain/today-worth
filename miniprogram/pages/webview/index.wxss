.setup-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 96rpx 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    linear-gradient(90deg, rgba(20, 25, 35, 0.06) 1px, transparent 1px),
    linear-gradient(0deg, rgba(20, 25, 35, 0.06) 1px, transparent 1px),
    #fff7d6;
  background-size: 28rpx 28rpx;
}

.setup-card {
  width: 100%;
  max-width: 600rpx;
  box-sizing: border-box;
  padding: 42rpx 36rpx;
  border: 6rpx solid #141923;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 12rpx 12rpx 0 #ffdc3f;
}

.setup-badge {
  display: inline-flex;
  padding: 8rpx 18rpx;
  border: 4rpx solid #141923;
  border-radius: 999rpx;
  background: #b8f3db;
  font-size: 24rpx;
  font-weight: 800;
}

.setup-title {
  margin-top: 28rpx;
  font-size: 42rpx;
  line-height: 1.2;
  font-weight: 900;
}

.setup-desc {
  margin-top: 18rpx;
  color: #5f6878;
  font-size: 28rpx;
  line-height: 1.7;
  font-weight: 700;
}
