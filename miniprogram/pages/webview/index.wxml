<web-view
  wx:if="{{h5Url}}"
  src="{{h5Url}}"
  bindload="onWebViewLoad"
  binderror="onWebViewError"
  bindmessage="onWebViewMessage"
></web-view>

<view wx:else class="setup-page">
  <view class="setup-card">
    <view class="setup-badge">接入准备</view>
    <view class="setup-title">还没有配置 H5 地址</view>
    <view class="setup-desc">
      先把 H5 部署到已备案的 HTTPS 域名，再把地址填入 miniprogram/app.js 的 h5Url。
    </view>
  </view>
</view>
