.page-header { display: flex; flex-direction: column; gap: 8rpx; margin: 6rpx 0 26rpx; }
.page-header text:first-child { font-size: 52rpx; font-weight: 900; }
.page-header text:last-child { color: #596377; font-size: 24rpx; font-weight: 700; }
.preview { display: grid; grid-template-columns: repeat(3,1fr); overflow: hidden; background: #ffdc3f; }
.preview view { display: flex; min-width: 0; padding: 22rpx 12rpx; flex-direction: column; gap: 8rpx; border-left: 3rpx solid #131b2b; }
.preview view:first-child { border-left: 0; }
.preview text:first-child { color: #596377; font-size: 20rpx; font-weight: 700; }
.preview text:last-child { overflow: hidden; font-size: 27rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }
.form-card { margin-top: 30rpx; padding: 8rpx 24rpx; }
.form-card label { display: flex; padding: 24rpx 0; flex-direction: column; gap: 14rpx; border-bottom: 2rpx dashed #bbc3cf; color: #303b50; font-size: 24rpx; font-weight: 800; }
.form-card label:last-child { border-bottom: 0; }
.form-card label > view { display: grid; grid-template-columns: 1fr auto; align-items: center; gap: 14rpx; }
.form-card input { height: 76rpx; padding: 0 18rpx; border: 3rpx solid #131b2b; border-radius: 10rpx; background: #f5f7fb; color: #131b2b; font-size: 28rpx; font-weight: 800; box-sizing: border-box; }
.form-card label > view > text { min-width: 60rpx; font-size: 23rpx; }
.save-button, .clear-button { width: 100%; height: 92rpx; margin: 30rpx 0 0; border: 4rpx solid #131b2b; border-radius: 14rpx; font-size: 28rpx; font-weight: 900; }
.save-button { background: #2f6bff; box-shadow: 7rpx 7rpx 0 #131b2b; color: #fff; }
.clear-button { margin-top: 22rpx; background: #fff; color: #d83a34; }
.privacy-note { display: block; padding: 24rpx 24rpx 0; color: #687186; font-size: 21rpx; line-height: 1.6; text-align: center; }
