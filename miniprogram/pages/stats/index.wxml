<view class="page-shell stats-page">
  <view class="page-header">
    <text>数据统计</text>
    <text>每一笔带薪时间，都有出处。</text>
  </view>

  <view class="period-tabs">
    <button wx:for="{{periods}}" wx:key="key" class="{{activePeriod === item.key ? 'is-active' : ''}}" data-period="{{item.key}}" bindtap="selectPeriod">{{item.label}}</button>
  </view>

  <view class="summary-grid">
    <view class="summary-card comic-card accent"><text>{{summary.count}}</text><text>{{periodLabel}}次数</text></view>
    <view class="summary-card comic-card"><text>{{summary.secondsText}}</text><text>累计时长</text></view>
    <view class="summary-card comic-card"><text>{{summary.moneyText}}</text><text>累计收入</text></view>
    <view class="summary-card comic-card verdict"><text>{{verdict.label}}</text><text>{{verdict.detail}}</text></view>
  </view>

  <view class="section-heading"><text>老板的钱花哪了</text><text>{{periodLabel}} · 三类贡献</text></view>
  <view class="contribution-card comic-card">
    <view wx:for="{{contributions}}" wx:key="key" class="contribution-row">
      <text class="contribution-stamp" style="background: {{item.color}};">{{item.stamp}}</text>
      <view class="contribution-copy"><view><text>{{item.label}}</text><text>{{item.percent}}%</text></view><view class="bar"><view style="width: {{item.percent}}%; background: {{item.color}};"></view></view><text>{{item.countText}} · {{item.secondsText}}</text></view>
      <text>{{item.moneyText}}</text>
    </view>
  </view>

  <view class="section-heading"><text>收益明细</text><text>最近 8 笔</text></view>
  <view class="records-card comic-card">
    <view wx:if="{{!records.length}}" class="empty">还没有记录，先去首页赚第一笔。</view>
    <view wx:for="{{records}}" wx:key="id" class="record-row">
      <text>{{item.stamp}}</text><view><text>{{item.label}}</text><text>{{item.time}}</text></view><view><text>{{item.moneyText}}</text><text>{{item.secondsText}}</text></view>
    </view>
  </view>
</view>
