<view class="page-shell stats-page">
  <view class="page-header">
    <text class="page-title">数据统计</text>
    <text class="page-subtitle">{{pageSubtitle}}</text>
  </view>

  <view class="period-tabs">
    <button wx:for="{{periods}}" wx:key="key" class="period-button {{activePeriod === item.key ? 'is-active' : ''}}" data-period="{{item.key}}" bindtap="selectPeriod">{{item.label}}</button>
  </view>

  <view class="summary-grid">
    <view class="summary-card comic-card accent"><text class="summary-value">{{summary.count}}</text><text class="summary-label">{{periodLabel}}次数</text></view>
    <view class="summary-card comic-card"><text class="summary-value">{{summary.secondsText}}</text><text class="summary-label">累计时长</text></view>
    <view class="summary-card comic-card"><text class="summary-value">{{summary.moneyText}}</text><text class="summary-label">累计收入</text></view>
    <view class="summary-card comic-card verdict"><text class="summary-value verdict-value">{{verdict.label}}</text><text class="summary-label">{{verdict.detail}}</text></view>
  </view>

  <view class="section-heading"><text class="section-title">老板的钱花哪了</text><text class="section-note">{{periodLabel}} · {{contributionNote}}</text></view>
  <view class="contribution-card comic-card">
    <view wx:for="{{contributions}}" wx:key="key" class="contribution-row">
      <text class="contribution-stamp" style="background: {{item.color}};">{{item.stamp}}</text>
      <view class="contribution-copy"><view class="contribution-head"><text>{{item.label}}</text><text>{{item.percent}}%</text></view><view class="bar"><view class="bar-fill" style="width: {{item.percent}}%; background: {{item.color}};"></view></view><text class="contribution-detail">{{item.countText}} · {{item.secondsText}}</text></view>
      <text class="contribution-money">{{item.moneyText}}</text>
    </view>
  </view>

  <view class="section-heading"><text class="section-title">收益明细</text><text class="section-note">{{recordsNote}}</text></view>
  <view class="records-card comic-card">
    <view wx:if="{{!records.length}}" class="empty">{{emptyText}}</view>
    <view wx:for="{{records}}" wx:key="id" class="record-row">
      <text class="record-stamp">{{item.stamp}}</text><view class="record-copy"><text class="record-title">{{item.label}}</text><text class="record-detail">{{item.time}}</text></view><view class="record-copy record-values"><text class="record-title">{{item.moneyText}}</text><text class="record-detail">{{item.secondsText}}</text></view>
    </view>
  </view>
</view>
