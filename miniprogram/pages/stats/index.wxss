.page-header { display: flex; flex-direction: column; gap: 8rpx; margin: 6rpx 0 26rpx; }
.page-title { font-size: 52rpx; font-weight: 900; }
.page-subtitle { color: #596377; font-size: 24rpx; font-weight: 700; }
.period-tabs { display: flex; width: 100%; padding: 6rpx; overflow: hidden; border: 3rpx solid #131b2b; border-radius: 14rpx; background: #e7ebf1; box-sizing: border-box; }
.period-button { flex: 1 1 0; width: 0; min-width: 0; height: 66rpx; margin: 0; padding: 0; overflow: hidden; border-radius: 10rpx; background: transparent; color: #687186; font-size: 24rpx; font-weight: 900; line-height: 66rpx; text-overflow: ellipsis; white-space: nowrap; box-sizing: border-box; }
.period-button.is-active { border: 3rpx solid #131b2b; background: #fff; box-shadow: 3rpx 3rpx 0 #131b2b; color: #131b2b; }
.summary-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-top: 26rpx; }
.summary-card { display: flex; min-height: 150rpx; padding: 22rpx; flex-direction: column; justify-content: space-between; box-sizing: border-box; }
.summary-value { font-size: 36rpx; font-weight: 900; }
.summary-label { color: #596377; font-size: 21rpx; font-weight: 700; }
.summary-card.accent { background: #2f6bff; color: #fff; }
.summary-card.accent .summary-label { color: rgba(255,255,255,.8); }
.summary-card.verdict { background: #ffdc3f; }
.verdict-value { font-size: 29rpx; }
.contribution-card, .records-card { padding: 10rpx 22rpx; }
.contribution-row { display: grid; grid-template-columns: 62rpx 1fr auto; gap: 16rpx; align-items: center; padding: 22rpx 0; border-bottom: 2rpx dashed #bdc5d1; }
.contribution-row:last-child { border-bottom: 0; }
.contribution-stamp { display: flex; width: 58rpx; height: 58rpx; align-items: center; justify-content: center; border: 3rpx solid #131b2b; border-radius: 10rpx; font-size: 20rpx; font-weight: 900; }
.contribution-copy { display: flex; min-width: 0; flex-direction: column; gap: 8rpx; }
.contribution-head { display: flex; min-width: 0; justify-content: space-between; gap: 14rpx; font-size: 23rpx; font-weight: 900; }
.contribution-head text:first-child { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.contribution-detail { overflow: hidden; color: #687186; font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }
.contribution-money { font-size: 24rpx; font-weight: 900; text-align: right; white-space: nowrap; }
.bar { height: 14rpx; overflow: hidden; border: 2rpx solid #131b2b; border-radius: 999rpx; background: #edf0f4; }
.bar-fill { height: 100%; }
.record-row { display: grid; grid-template-columns: 54rpx 1fr auto; gap: 14rpx; align-items: center; padding: 20rpx 0; border-bottom: 2rpx dashed #bdc5d1; }
.record-row:last-child { border-bottom: 0; }
.record-row:active { background: #f0f4fb; }
.record-detail-mask { position: fixed; inset: 0; z-index: 100; display: flex; padding: 32rpx; align-items: center; justify-content: center; background: rgba(19,27,43,.72); box-sizing: border-box; }
.record-detail-card { width: 100%; padding: 28rpx; box-sizing: border-box; }
.record-detail-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.record-detail-kicker { color: #687186; font-size: 20rpx; font-weight: 900; }
.record-detail-stamp { display: flex; width: 64rpx; height: 64rpx; align-items: center; justify-content: center; border: 3rpx solid #131b2b; border-radius: 50%; background: #ffdc3f; font-size: 22rpx; font-weight: 900; }
.record-detail-title { display: block; margin: 12rpx 0 22rpx; font-size: 36rpx; font-weight: 900; }
.record-detail-list { overflow: hidden; border: 3rpx solid #131b2b; border-radius: 10rpx; }
.record-detail-list view { display: grid; min-width: 0; min-height: 72rpx; padding: 14rpx 16rpx; grid-template-columns: 132rpx minmax(0,1fr); align-items: center; gap: 12rpx; border-bottom: 2rpx solid #d8dee9; box-sizing: border-box; }
.record-detail-list view:last-child { border-bottom: 0; }
.record-detail-list text:first-child { color: #687186; font-size: 20rpx; font-weight: 800; }
.record-detail-list text:last-child { min-width: 0; overflow-wrap: anywhere; font-size: 22rpx; font-weight: 900; text-align: right; }
.record-detail-close, .record-detail-delete { width: 100%; min-height: 82rpx; margin: 18rpx 0 0; border: 3rpx solid #131b2b; border-radius: 12rpx; font-size: 25rpx; font-weight: 900; box-sizing: border-box; }
.record-detail-close { background: #2f6bff; box-shadow: 6rpx 6rpx 0 #131b2b; color: #fff; }
.record-detail-delete { margin-top: 14rpx; background: #fff; color: #a23c38; }
.record-stamp { font-size: 21rpx; font-weight: 900; }
.record-copy { display: flex; min-width: 0; flex-direction: column; gap: 4rpx; }
.record-title { overflow: hidden; font-size: 23rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }
.record-detail { overflow: hidden; color: #687186; font-size: 19rpx; text-overflow: ellipsis; white-space: nowrap; }
.record-values { align-items: flex-end; }
.empty { padding: 52rpx 20rpx; color: #687186; font-size: 23rpx; text-align: center; }
