.page-header { display: flex; flex-direction: column; gap: 8rpx; margin: 6rpx 0 26rpx; }
.page-header text:first-child { font-size: 52rpx; font-weight: 900; }
.page-header text:last-child { color: #596377; font-size: 24rpx; font-weight: 700; }
.period-tabs { display: grid; grid-template-columns: repeat(4,1fr); padding: 6rpx; border: 3rpx solid #131b2b; border-radius: 14rpx; background: #e7ebf1; }
.period-tabs button { height: 66rpx; margin: 0; padding: 0; border-radius: 10rpx; background: transparent; color: #687186; font-size: 25rpx; font-weight: 900; line-height: 66rpx; }
.period-tabs button.is-active { border: 3rpx solid #131b2b; background: #fff; box-shadow: 3rpx 3rpx 0 #131b2b; color: #131b2b; }
.summary-grid { display: grid; grid-template-columns: repeat(2,1fr); gap: 18rpx; margin-top: 26rpx; }
.summary-card { display: flex; min-height: 150rpx; padding: 22rpx; flex-direction: column; justify-content: space-between; box-sizing: border-box; }
.summary-card > text:first-child { font-size: 36rpx; font-weight: 900; }
.summary-card > text:last-child { color: #596377; font-size: 21rpx; font-weight: 700; }
.summary-card.accent { background: #2f6bff; color: #fff; }
.summary-card.accent > text:last-child { color: rgba(255,255,255,.8); }
.summary-card.verdict { background: #ffdc3f; }
.summary-card.verdict > text:first-child { font-size: 29rpx; }
.contribution-card, .records-card { padding: 10rpx 22rpx; }
.contribution-row { display: grid; grid-template-columns: 62rpx 1fr auto; gap: 16rpx; align-items: center; padding: 22rpx 0; border-bottom: 2rpx dashed #bdc5d1; }
.contribution-row:last-child { border-bottom: 0; }
.contribution-stamp { display: flex; width: 58rpx; height: 58rpx; align-items: center; justify-content: center; border: 3rpx solid #131b2b; border-radius: 10rpx; font-size: 20rpx; font-weight: 900; }
.contribution-copy { display: flex; min-width: 0; flex-direction: column; gap: 8rpx; }
.contribution-copy > view:first-child { display: flex; justify-content: space-between; font-size: 23rpx; font-weight: 900; }
.contribution-copy > text { color: #687186; font-size: 19rpx; }
.contribution-row > text:last-child { font-size: 24rpx; font-weight: 900; }
.bar { height: 14rpx; overflow: hidden; border: 2rpx solid #131b2b; border-radius: 999rpx; background: #edf0f4; }
.bar view { height: 100%; }
.record-row { display: grid; grid-template-columns: 54rpx 1fr auto; gap: 14rpx; align-items: center; padding: 20rpx 0; border-bottom: 2rpx dashed #bdc5d1; }
.record-row:last-child { border-bottom: 0; }
.record-row > text:first-child { font-size: 21rpx; font-weight: 900; }
.record-row view { display: flex; flex-direction: column; gap: 4rpx; }
.record-row view text:first-child { font-size: 23rpx; font-weight: 900; }
.record-row view text:last-child { color: #687186; font-size: 19rpx; }
.record-row > view:last-child { align-items: flex-end; }
.empty { padding: 52rpx 20rpx; color: #687186; font-size: 23rpx; text-align: center; }
